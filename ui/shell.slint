export { ThemePicker, PreviewCard } from "theme-picker.slint";
export { KeybindingsEditor, KeyRow } from "keybindings.slint";

export component Background inherits Window {
    no-frame: true;
    in property <length> surface-width;
    in property <length> surface-height;
    width: surface-width;
    height: surface-height;
    in property <color> bg;
    background: bg;
    in property <image> wallpaper;
    Image {
        width: parent.width;
        height: parent.height;
        source: root.wallpaper;
        image-fit: cover;
    }
}
export struct StatusItem { kind: string, value: string, icon: image, has-icon: bool, level: int, charging: bool, hint-id: int }
component StatusModule inherits Rectangle {
    in property <StatusItem> item;
    in property <color> fg;
    in property <color> muted;
    in property <color> bg;
    /// Horizontal center of the module in window coordinates, for anchoring a popup.
    callback clicked(length);
    in property <int> hint-request;
    callback hint-position(int, int, length);
    changed hint-request => {
        if root.hint-request > 0 && root.item.hint-id > 0 {
            root.hint-position(root.hint-request, root.item.hint-id, root.x + root.width / 2);
        }
    }
    property <bool> has-icon: item.has-icon || item.kind == "cpu" || item.kind == "memory";
    property <bool> separator: item.kind == "separator";
    width: layout.preferred-width;
    layout := HorizontalLayout {
        spacing: 6px;
        // A purely visual dot between neighbouring modules; it may be listed several times.
        if separator: Rectangle {
            width: 4px; height: 4px; border-radius: 2px;
            y: (parent.height - self.height) / 2;
            background: muted;
        }
        // Battery drawn from its level: outline, terminal, fill and a bolt while charging.
        if item.kind == "battery": Rectangle {
            width: 16px; height: 14px;
            y: (parent.height - self.height) / 2;
            Rectangle {
                x: 0; y: 3px; width: 13px; height: 8px;
                border-width: 1px; border-color: muted; border-radius: 1.5px;
                Rectangle { x: 2px; y: 2px; width: 9px * max(0, min(100, item.level)) / 100; height: 4px; background: muted; }
            }
            Rectangle { x: 13.5px; y: 5.5px; width: 1.5px; height: 3px; border-radius: 0.5px; background: muted; }
            if item.charging: Path {
                x: 0; y: 0; width: 16px; height: 14px;
                viewbox-width: 16; viewbox-height: 14;
                commands: "M 8.6 0.5 L 3.8 8 L 7.2 8 L 6.2 13.5 L 11.2 5.8 L 7.8 5.8 Z";
                fill: fg; stroke: bg; stroke-width: 1.2px;
            }
        }
        if has-icon: Image {
            width: 14px; height: 14px;
            y: (parent.height - self.height) / 2;
            source: item.kind == "cpu" ? @image-url("icons/cpu.svg")
                : item.kind == "memory" ? @image-url("icons/memory.svg")
                : item.icon;
            colorize: muted;
        }
        if !separator: Text { text: item.value; color: fg; vertical-alignment: center; }
    }
    // A separator is not clickable: the press reaches the bar background like an empty area.
    TouchArea { enabled: !root.separator; clicked => { root.clicked(root.x + root.width / 2); } }
}
export component Bar inherits Window {
    no-frame: true;
    in property <length> surface-width;
    in property <length> surface-height;
    width: surface-width;
    height: surface-height;
    in property <color> bg;
    in property <color> fg;
    in property <color> accent;
    in property <color> muted;
    in property <int> active;
    /// Workspace numbers to show: the occupied ones and the active one.
    in property <[int]> workspaces;
    in property <[StatusItem]> before-workspace-items;
    in property <[StatusItem]> left-items;
    in property <[StatusItem]> center-items;
    in property <[StatusItem]> right-items;
    callback workspace(int);
    /// A module was clicked: its kind and horizontal center in the bar.
    callback module(string, length);
    in property <int> hint-request;
    callback hint-position(int, int, length);
    /// Shared theme/application opacity affects only the base surface.
    in property <float> background-opacity: 1;
    /// Clicking the bar can still hide its surface completely.
    in property <bool> transparent;
    /// Empty bar area clicked, outside every module.
    callback toggle-background();
    background: root.transparent ? Colors.transparent : root.bg.with-alpha(root.background-opacity);
    // Declared first so the module and workspace touch areas stay above it.
    TouchArea { clicked => { root.toggle-background(); } }
    // Each group is anchored on its own, so the center group is centered on
    // the screen whatever the side groups measure.
    center-group := HorizontalLayout {
        x: (root.width - self.width) / 2; height: root.height; width: self.preferred-width;
        padding-top: 4px; padding-bottom: 4px; spacing: 16px;
        for item in root.center-items: StatusModule {
            item: item; fg: root.fg; muted: root.muted; bg: root.bg;
            hint-request: root.hint-request;
            hint-position(epoch, index, x) => { root.hint-position(epoch, index, center-group.x + x); }
            clicked(x) => { root.module(item.kind, center-group.x + x); }
        }
    }
    left-group := HorizontalLayout {
        x: 0; height: root.height; width: self.preferred-width;
        padding-left: 4px; padding-top: 4px; padding-bottom: 4px; spacing: 8px;
        for item in root.before-workspace-items: StatusModule {
            item: item; fg: root.fg; muted: root.muted; bg: root.bg;
            hint-request: root.hint-request;
            hint-position(epoch, index, x) => { root.hint-position(epoch, index, left-group.x + x); }
            clicked(x) => { root.module(item.kind, left-group.x + x); }
        }
        for n in root.workspaces: Rectangle {
            width: 25px;
            // Inactive workspaces reveal the single base surface, avoiding a
            // second opacity layer. The active indicator and all text stay opaque.
            background: root.active == n ? root.accent : Colors.transparent;
            Text { text: "\{n}"; color: root.active == n ? root.bg : root.fg; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { clicked => { root.workspace(n); } }
        }
        for item in root.left-items: StatusModule {
            item: item; fg: root.fg; muted: root.muted; bg: root.bg;
            hint-request: root.hint-request;
            hint-position(epoch, index, x) => { root.hint-position(epoch, index, left-group.x + x); }
            clicked(x) => { root.module(item.kind, left-group.x + x); }
        }
    }
    right-group := HorizontalLayout {
        x: root.width - self.width; height: root.height; width: self.preferred-width;
        padding-right: 12px; padding-top: 4px; padding-bottom: 4px; spacing: 16px;
        for item in root.right-items: StatusModule {
            item: item; fg: root.fg; muted: root.muted; bg: root.bg;
            hint-request: root.hint-request;
            hint-position(epoch, index, x) => { root.hint-position(epoch, index, right-group.x + x); }
            clicked(x) => { root.module(item.kind, right-group.x + x); }
        }
    }
}
export struct BarHint { center: length, label: string }
export component BarHints inherits Window {
    no-frame: true;
    in property <length> surface-width;
    width: surface-width;
    height: 26px;
    background: transparent;
    in property <color> bg;
    in property <color> fg;
    in property <color> accent;
    in property <int> selected;
    in property <[BarHint]> hints;
    for hint[index] in root.hints: Rectangle {
        x: max(0px, min(root.width - self.width, hint.center - self.width / 2));
        y: 1px; width: 24px; height: 24px;
        border-radius: 5px; border-width: 1px; border-color: root.accent;
        background: root.selected == index ? root.accent : root.bg;
        Text {
            text: hint.label;
            color: root.selected == index ? root.bg : root.fg;
            font-size: 13px; font-weight: 700;
            horizontal-alignment: center; vertical-alignment: center;
        }
    }
}
export component Popup inherits Window {
    no-frame: true;
    in property <length> surface-width;
    in property <length> surface-height;
    width: surface-width;
    height: surface-height;
    in property <color> bg;
    in property <color> fg;
    in property <color> muted;
    in property <color> overlay;
    in property <string> heading;
    in property <[string]> lines;
    background: bg;
    Rectangle {
        border-width: 1px;
        border-color: root.overlay;
        VerticalLayout {
            padding: 14px; spacing: 6px;
            Text { text: root.heading; color: root.muted; font-size: 11px; letter-spacing: 1px; }
            for line in root.lines: Text { text: line; color: root.fg; }
        }
    }
}
export component Launcher inherits Window {
    no-frame: true;
    in property <length> surface-width;
    in property <length> surface-height;
    width: surface-width;
    height: surface-height;
    in property <color> bg;
    in property <color> fg;
    in property <color> accent;
    in property <color> overlay;
    in property <[string]> results;
    in-out property <int> selected: 0;
    in-out property <string> query;
    callback search(string);
    callback activate(int);
    callback dismiss();
    /// Backspace pressed while the query is empty.
    callback back();
    background: bg;
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) { root.dismiss(); return accept; }
            if (event.text == Key.DownArrow) { root.selected = min(root.selected + 1, root.results.length - 1); return accept; }
            if (event.text == Key.UpArrow) { root.selected = max(0, root.selected - 1); return accept; }
            if (event.text == Key.Return) { root.activate(root.selected); return accept; }
            return reject;
        }
        VerticalLayout {
            padding: 12px; spacing: 6px;
            Rectangle {
                height: 36px;
                border-width: 1px;
                border-color: root.overlay;
                Text { x: 8px; text: ">"; color: root.accent; vertical-alignment: center; }
                input := TextInput {
                    x: 28px; width: parent.width - 36px; height: parent.height;
                    text <=> root.query;
                    color: root.fg;
                    selection-background-color: root.accent;
                    selection-foreground-color: root.bg;
                    single-line: true;
                    vertical-alignment: center;
                    edited => {root.selected = 0; root.search(self.text);}
                    accepted => {root.activate(root.selected);}
                    // TextInput consumes the arrows as cursor line moves before
                    // the enclosing FocusScope can see them.
                    key-pressed(event) => {
                        if (event.text == Key.DownArrow) { root.selected = min(root.selected + 1, root.results.length - 1); return accept; }
                        if (event.text == Key.UpArrow) { root.selected = max(0, root.selected - 1); return accept; }
                        if (event.text == Key.Backspace && self.text == "") { root.back(); return accept; }
                        return reject;
                    }
                }
            }
            for name[index] in root.results: Rectangle {
                height: 32px;
                background: root.selected == index ? root.overlay : root.bg;
                Text { text: name; color: root.selected == index ? root.accent : root.fg; vertical-alignment: center; x: 8px; }
                TouchArea { clicked => {root.activate(index);} }
            }
        }
    }
    public function focus-search() { input.focus(); }
}
