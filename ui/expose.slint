// Exposé: every managed window of every workspace as a card over the blurred
// wallpaper. Geometry is computed by the daemon (src/expose.rs); the view only
// draws the slots it is given and reports keys, clicks and hovers. Live
// previews are DWM thumbnails composed over the card area by the daemon.
export struct ExposeCard {
    title: string,
    app: string,
    workspace: string,
    /// The DWM composes the window into the thumbnail area; nothing to draw there.
    live: bool,
    icon: image,
    has-icon: bool,
    focused: bool,
    minimized: bool,
    /// Thumbnail rectangle; the label strip hangs below it.
    x: length, y: length,
    width: length, height: length,
}

export component ExposeView inherits Window {
    title: "Winarchy Exposé";
    no-frame: true;
    default-font-family: "JetBrains Mono";
    in property <length> surface-width;
    in property <length> surface-height;
    width: surface-width; height: surface-height;
    in property <color> bg;
    in property <color> surface;
    in property <color> overlay;
    in property <color> fg;
    in property <color> muted;
    in property <color> accent;
    in property <[ExposeCard]> cards;
    in-out property <int> selected: 0;
    in property <string> query;
    /// "6 windows", for the right side of the filter box.
    in property <string> count;
    in property <string> hint;
    /// Blurred wallpaper of the monitor; the theme background shows without one.
    in property <image> backdrop;
    in property <bool> has-backdrop;
    /// Set once the native window has its final size, like the keybindings
    /// editor: the first frame then repaints the whole surface.
    in property <bool> ready;
    /// Height of the label strip under each thumbnail (src/expose.rs LABEL).
    in property <length> label-height: 64px;
    callback key(string, bool, bool, bool, bool);
    callback activate(int);
    callback close-window(int);
    callback hover(int);
    callback dismiss();
    background: root.bg;
    forward-focus: keys;
    if root.has-backdrop && root.ready: Image {
        width: root.width; height: root.height;
        source: root.backdrop;
        image-fit: cover;
        image-rendering: smooth;
    }
    Rectangle {
        width: root.width; height: root.height;
        background: root.bg.with-alpha(root.has-backdrop ? 0.55 : 0.0);
    }
    keys := FocusScope {
        width: root.width; height: root.height;
        key-pressed(event) => {
            root.key(event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
            return accept;
        }
        key-released(event) => { return accept; }
        // Declared first so the cards' own touch areas stay above it.
        TouchArea { clicked => { root.dismiss(); } }
        // Filter box.
        Rectangle {
            visible: root.ready;
            width: min(600px, root.width - 160px); height: 48px;
            x: (root.width - self.width) / 2; y: 28px;
            background: root.bg.with-alpha(0.85);
            border-width: 1px;
            border-color: root.query == "" ? root.fg.with-alpha(0.35) : root.accent;
            border-radius: 3px;
            HorizontalLayout {
                padding-left: 16px; padding-right: 16px; spacing: 12px;
                Image {
                    width: 16px; height: 16px;
                    y: (parent.height - self.height) / 2;
                    source: @image-url("icons/search.svg");
                    colorize: root.query == "" ? root.muted : root.accent;
                }
                Text {
                    text: root.query == "" ? "Type to filter windows…" : root.query;
                    color: root.query == "" ? root.muted : root.fg;
                    font-size: 15px;
                    vertical-alignment: center; overflow: elide;
                    horizontal-stretch: 1;
                }
                Text {
                    text: root.count; color: root.muted; font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }
        Text {
            visible: root.ready && root.cards.length == 0;
            width: root.width; height: root.height;
            text: root.query == "" ? "No windows" : "No matching window";
            color: root.muted; font-size: 16px;
            horizontal-alignment: center; vertical-alignment: center;
        }
        for card[index] in root.cards: box := Rectangle {
            visible: root.ready;
            x: card.x; y: card.y;
            width: card.width; height: card.height + root.label-height;
            property <bool> current: root.selected == index;
            Rectangle {
                x: 0; y: 0; width: card.width; height: card.height;
                background: root.surface.with-alpha(card.live ? 1.0 : 0.85);
                border-width: box.current ? 2px : 1px;
                border-color: box.current ? root.accent : card.focused ? root.accent.with-alpha(0.55) : root.fg.with-alpha(0.25);
                border-radius: 2px;
                clip: true;
                if !card.live && card.has-icon: Image {
                    width: min(96px, parent.width / 3, parent.height / 2); height: self.width;
                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                    source: card.icon;
                    image-fit: contain;
                    image-rendering: smooth;
                    opacity: card.minimized ? 0.45 : 0.9;
                }
                if !card.live && !card.has-icon: Text {
                    width: parent.width; height: parent.height;
                    text: card.app; color: root.muted; font-size: 16px;
                    horizontal-alignment: center; vertical-alignment: center;
                    overflow: elide;
                }
            }
            HorizontalLayout {
                x: 0; y: card.height;
                width: card.width; height: root.label-height;
                padding-top: 12px; spacing: 12px;
                if card.has-icon: Image {
                    width: 28px; height: 28px;
                    source: card.icon;
                    image-fit: contain;
                    image-rendering: smooth;
                }
                if !card.has-icon: Rectangle {
                    width: 28px; height: 28px;
                    background: root.overlay; border-radius: 4px;
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: start; spacing: 2px;
                    Text {
                        text: card.title == "" ? card.app : card.title;
                        color: box.current ? root.fg : root.fg.with-alpha(0.9);
                        font-size: 13px; font-weight: box.current ? 700 : 400;
                        overflow: elide;
                    }
                    Text {
                        text: card.minimized ? card.app + " · minimized" : card.app;
                        color: root.muted; font-size: 11px;
                        overflow: elide;
                    }
                }
                VerticalLayout {
                    alignment: start; spacing: 2px;
                    Text {
                        text: card.workspace;
                        color: card.focused ? root.accent : root.fg;
                        font-size: 14px; font-weight: 700;
                        horizontal-alignment: right;
                    }
                    Text {
                        text: "Workspace"; color: root.muted; font-size: 10px;
                        horizontal-alignment: right;
                    }
                }
            }
            TouchArea {
                clicked => { root.activate(index); }
                moved => { if (self.has-hover) { root.hover(index); } }
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.middle) {
                        root.close-window(index);
                    }
                }
            }
        }
        Text {
            visible: root.ready && root.cards.length > 0;
            x: 0; y: root.height - 44px; width: root.width;
            text: root.hint;
            color: root.muted; font-size: 12px;
            horizontal-alignment: center;
        }
    }
    public function focus-view() { keys.focus(); }
}
