// One RGB frame per monitor at its physical resolution, drawn by the
// winarchy-screensaver crate like Omarchy's full-screen tte terminal.
export component ScreensaverView inherits Rectangle {
    in property <image> frame;
    background: #000;
    Image {
        width: root.width;
        height: root.height;
        source: root.frame;
        image-fit: fill;
        image-rendering: pixelated;
    }
    TouchArea { mouse-cursor: none; }
}
