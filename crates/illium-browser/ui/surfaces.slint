export struct PaletteRow {
    title: string,
    detail: string,
    badge: string,
    group: string,
}

export component BrowserSurface inherits Window {
    no-frame: true;
    background: transparent;
    default-font-family: "Cascadia Mono";
    default-font-size: 13px;
    in property <color> bg;
    in property <color> surface;
    in property <color> text-color;
    in property <color> subtext;
    in property <color> accent;
    in property <color> border;
    in property <float> background-opacity: 0.85;
    // 0 = home background, 1 = navigation/tabs, 2 = leader.
    in property <int> kind;
    in property <string> heading;
    in property <string> footer;
    in property <[PaletteRow]> rows;
    in property <int> selected: -1;
    in property <length> row-height: 70px;
    in property <int> columns: 1;
    in-out property <length> scroll-offset;
    callback activate(int);
    in property <image> input-image;
    in property <length> input-x;
    in property <length> input-y;
    in property <length> input-width;
    in property <length> input-height;
    in property <bool> input-empty;
    in property <string> input-placeholder;

    Rectangle {
        background: (root.kind == 0 ? root.bg : root.surface).with-alpha(root.background-opacity);
        border-width: root.kind == 0 ? 0px : 1px;
        border-color: root.border;
        if root.kind != 0: Text {
            x: 20px; y: root.kind == 1 ? 64px : 12px;
            width: parent.width - 40px; height: 28px;
            text: root.heading; color: root.accent;
            overflow: elide; vertical-alignment: center;
        }
        if root.kind == 1: Rectangle {
            x: 16px; y: 12px; width: max(1px, parent.width - 80px); height: 36px;
            // The palette already supplies the theme alpha. Do not stack a
            // second background here, which would make the field more opaque.
            background: transparent;
            border-radius: 6px;
            border-width: 1px;
            border-color: root.accent.with-alpha(0.45);
            // Draw the magnifier, rather than relying on a font's symbol coverage.
            Path {
                x: 12px; y: 9px; width: 18px; height: 18px;
                viewbox-width: 20; viewbox-height: 20;
                commands: "M 8 2 A 6 6 0 1 0 8 14 A 6 6 0 1 0 8 2 M 12.5 12.5 L 18 18";
                fill: transparent; stroke: root.accent; stroke-width: 1.5px;
            }
        }
        if root.kind == 1 && root.input-empty: Text {
            x: root.input-x + 2px; y: root.input-y;
            width: max(0px, root.input-width - 2px); height: root.input-height;
            text: root.input-placeholder; color: root.subtext;
            vertical-alignment: center; overflow: elide;
        }
        if root.kind == 1: Image {
            x: root.input-x; y: root.input-y;
            width: root.input-width; height: root.input-height;
            source: root.input-image;
        }
        if root.kind == 1: Text {
            x: parent.width - 48px; y: 12px; width: 38px; height: 36px;
            text: "Esc"; color: root.subtext; vertical-alignment: center;
        }
        if root.kind != 0: Rectangle {
            x: 1px; y: root.kind == 1 ? 60px : 48px;
            width: parent.width - 2px; height: 1px; background: root.border;
        }
        if root.kind != 0: Rectangle {
            x: 20px; y: root.kind == 1 ? 93px : 52px;
            width: parent.width - 40px;
            height: max(0px, parent.height - self.y - 44px);
            clip: true;
            if root.rows.length == 0 && root.kind == 1: Text {
                x: 8px; y: 8px; width: parent.width - 16px; height: 24px;
                text: "No local results · Enter to search"; color: root.subtext;
                overflow: elide;
            }
            for row[index] in root.rows: Rectangle {
                x: mod(index, root.columns) * self.width;
                y: floor(index / root.columns) * root.row-height - root.scroll-offset;
                width: parent.width / root.columns;
                height: root.row-height;
                background: index == root.selected ? root.border.with-alpha(0.85) : transparent;
                Text {
                    x: 8px; y: 0px; width: parent.width - 120px; height: 19px;
                    text: row.group; color: root.subtext; overflow: elide;
                }
                Text {
                    x: parent.width - 112px; y: 0px; width: 104px; height: 19px;
                    text: row.badge; color: root.subtext; horizontal-alignment: right;
                    overflow: elide;
                }
                Text {
                    x: 8px; y: root.kind == 2 ? 0px : 22px;
                    width: parent.width - 16px; height: 23px;
                    text: row.title; color: index == root.selected ? root.accent : root.text-color;
                    overflow: elide; vertical-alignment: center;
                }
                Text {
                    x: 8px; y: 45px; width: parent.width - 16px; height: 20px;
                    text: row.detail; color: root.subtext; overflow: elide;
                }
                if root.kind == 1: TouchArea {
                    clicked => { root.activate(index); }
                }
            }
        }
        if root.kind != 0: Rectangle {
            x: 1px; y: parent.height - 42px; width: parent.width - 2px; height: 1px;
            background: root.border;
        }
        if root.kind != 0: Text {
            x: 20px; y: parent.height - 38px; width: parent.width - 40px; height: 32px;
            text: root.footer; color: root.subtext; overflow: elide;
            vertical-alignment: center;
        }
    }
}
