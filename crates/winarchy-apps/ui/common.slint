// Pieces every application shares: the theme palette and the chrome around a list.
export global Palette {
    in-out property <color> bg: #1e1e2e;
    in-out property <color> surface: #313244;
    in-out property <color> overlay: #45475a;
    in-out property <color> fg: #cdd6f4;
    in-out property <color> muted: #a6adc8;
    in-out property <color> accent: #cba6f7;
    in-out property <color> green: #a6e3a1;
    in-out property <color> yellow: #f9e2af;
    in-out property <color> red: #f38ba8;
}
// Scrolling list body that keeps the cursor row in view. Rows are supplied
// by the caller, `row-height` tall each. A Flickable bounds its maximum
// size to its content, which would make an empty list a fixed-size window
// at creation; the Rectangle keeps the constraints unbounded.
export component Column inherits Rectangle {
    in property <int> cursor;
    in property <length> row-height: 24px;
    /// Rows that fit; the applications use it for PageUp/PageDown.
    out property <int> page: max(1, floor(self.height / row-height));
    changed cursor => { keep-visible(); }
    changed height => { keep-visible(); }
    function keep-visible() {
        if (cursor * row-height < -flick.viewport-y) {
            flick.viewport-y = -cursor * row-height;
        } else if ((cursor + 1) * row-height > -flick.viewport-y + self.height) {
            flick.viewport-y = self.height - (cursor + 1) * row-height;
        }
    }
    flick := Flickable {
        width: 100%;
        height: 100%;
        VerticalLayout {
            alignment: start;
            @children
        }
    }
}
export component StatusLine inherits Rectangle {
    in property <string> left;
    in property <string> right;
    height: 26px;
    background: Palette.surface;
    HorizontalLayout {
        padding-left: 10px; padding-right: 10px; spacing: 12px;
        Text { text: root.left; color: Palette.fg; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        Text { text: root.right; color: Palette.muted; vertical-alignment: center; }
    }
}
export component KeyHelp inherits Rectangle {
    in property <[string]> lines;
    background: Palette.bg.with-alpha(0.85);
    Rectangle {
        width: min(root.width - 40px, 460px);
        height: layout.preferred-height;
        background: Palette.surface;
        border-width: 1px;
        border-color: Palette.overlay;
        layout := VerticalLayout {
            padding: 18px; spacing: 4px;
            Text { text: "KEYS"; color: Palette.muted; font-size: 11px; letter-spacing: 1px; }
            for line in root.lines: Text { text: line; color: Palette.fg; font-family: "Consolas"; font-size: 13px; }
        }
    }
}
